@{
}
@model Book

<h1>Create Book</h1>

<form asp-action="AddBook" method="post">
    <div>
        <label> Title</label>
        <input asp-for="Title" />
    </div>

    <div>
        <label> Author</label>
        <input asp-for="Author" />
    </div>

    <div>
        <label> Price</label>
        <input asp-for="Price" />
    </div>

    <input type="submit" value="Create" />
</form>

<a href="/Books">Back to List</a>
