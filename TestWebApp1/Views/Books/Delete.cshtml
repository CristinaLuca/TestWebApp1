@{
}
@model Book

<h2>Delete Book</h2>

<p>Are you sure you want to delete this book?</p>
<p>@Model.Title by @Model.Author</p>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit">Delete</button>
    <a asp-action="Index">Cancel</a>
</form>