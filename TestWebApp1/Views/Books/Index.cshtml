@{
}
<!-- directive tells the View that it will receive a list of strings.-->
@model IEnumerable<Book>

<h1>Book Store</h1>

<p>List of books</p>

<ul>
    <!-- Model is a special property in an ASP.NET Core MVC View. It contains the data that the Controller passes to the View -->
    @foreach (var book in Model)
    {
        <li>@book.Title by @book.Author - price: @book.Price</li>
    }

</ul>